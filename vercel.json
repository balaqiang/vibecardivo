{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "assets/fonts/**",
      "maxDuration": 10
    }
  },
  "rewrites": [{ "source": "/api/:path+", "destination": "/api" }]
}
